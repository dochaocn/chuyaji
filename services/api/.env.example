CHUYAJI_HTTP_ADDR=:8282
CHUYAJI_JWT_SECRET=change-me-in-production-use-long-random-string
CHUYAJI_DB_PATH=./data/chuyaji.db
CHUYAJI_WECHAT_APP_ID=
CHUYAJI_WECHAT_APP_SECRET=
# 开发：true 时可用 code=dev 登录（固定 openid），切勿在生产开启
CHUYAJI_DEV_MODE=false

# 附件本地上传（非空则启用 multipart 上传）；文件落盘目录
CHUYAJI_UPLOAD_DIR=./data/uploads
# 生成外链用的公网根，如 https://api.example.com（为空则回退为请求的 Host）
CHUYAJI_PUBLIC_BASE_URL=
